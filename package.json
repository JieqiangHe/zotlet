{
  "name": "zotlet",
  "version": "0.1.0",
  "description": "A minimal, personal reference manager: projects, DOI/PMID import, citeproc citations, CSL JSON/BibTeX/RIS export",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "zotlet": "zotlet.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node zotlet.js web --open",
    "test": "node --test",
    "package": "sh scripts/package.sh"
  },
  "dependencies": {
    "citeproc": "^2.4.63"
  }
}
